{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glitter",
  "version": "0.1.0",
  "identifier": "com.glitter.desktop",
  "build": {
    "beforeDevCommand": "bash src-tauri/dev-ui.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash src-tauri/build-ui.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Glitter",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        },
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 28
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "externalBin": ["binaries/glitter-node"],
    "resources": {
      "../../../packages/glitter-bridge/dist/index.js": "glitter-bridge/index.js"
    }
  }
}
